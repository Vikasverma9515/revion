# Eval Lab configuration. Copy to .env.local for development and add the same
# variables in Vercel → Project → Settings → Environment Variables.

# Agent LLM (https://console.groq.com/keys)
GROQ_API_KEY=

# Judge LLMs (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Database. Leave empty locally to use .data/lab.db. Required on Vercel,
# where local files do not persist (https://turso.tech).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: require this token to open /lab and call /api/lab (recommended in production).
LAB_ACCESS_TOKEN=
